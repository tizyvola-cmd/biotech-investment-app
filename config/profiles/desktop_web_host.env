# SuperNova Desktop Web — hosting Option B (server + browser)
# Carica prima di avviare l'API, es.:
#   Get-Content config/profiles/desktop_web_host.env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]+)=(.*)$') { Set-Item -Path "Env:$($matches[1].Trim())" -Value $matches[2].Trim() }
#   }

# UI + API stesso origin (http://host:8765/)
SUPERNOVA_SERVE_DESKTOP=1
SUPERNOVA_BIND_ALL=1
SUPERNOVA_PORT=8765

# Obbligatorio in produzione se BIND_ALL=1 (refresh manuali da UI)
SUPERNOVA_API_TOKEN=CAMBIA_QUESTA_CHIAVE

# Fuso orario scheduler (CET/CEST automatico)
SUPERNOVA_SCHEDULE_TIMEZONE=Europe/Rome

# Lun–Ven 15:30–22:00: quote Yahoo + Financial snapshot + live signals (~2–5 min)
SUPERNOVA_HOURLY_FINANCIAL=1
SUPERNOVA_HOURLY_FINANCIAL_START=15:30
SUPERNOVA_HOURLY_FINANCIAL_END=22:00

# Lun–Ven 07:00: nuovi CD (CT.gov/FDA) + IPO biotech + snapshot Simulation (~10–40 min)
SUPERNOVA_MORNING_REFRESH=1
SUPERNOVA_MORNING_REFRESH_TIME=07:00

# Lun–Ven 09:00: ricalcolo completo SDS Supernova (FMP + cluster A, ~5–15 min)
SUPERNOVA_SDS_REFRESH=1
SUPERNOVA_SDS_REFRESH_TIME=09:00

# Lun–Ven 10:00: feed clinico pre-CD + EIS + signal_calibration (~5–20 min, Claude → Copilot)
SUPERNOVA_EIS_REFRESH=1
SUPERNOVA_EIS_REFRESH_TIME=10:00

# Lun–Ven 16:30: RA Prediction Calibration + SDS Accuracy + EIS Magnitude (chart snapshot + SDS light + prezzi feed)
SUPERNOVA_MODEL_LAB_REFRESH=1
SUPERNOVA_MODEL_LAB_REFRESH_TIME=16:30

# Legacy disattivati (sostituiti da hourly financial + morning)
SUPERNOVA_SCHEDULED_REFRESH_MINUTES=0
SUPERNOVA_DAILY_REFRESH_HOUR=-1

# Sabato 07:00–14:00: orchestrator WeeklyFull (SEC K-8 + enrich, 30–90+ min, app chiusa ok)
SUPERNOVA_SATURDAY_WEEKLY_FULL=1
SUPERNOVA_SATURDAY_WEEKLY_FULL_TIME=07:00
SUPERNOVA_SATURDAY_WEEKLY_FULL_END=14:00

# Build UI: cd desktop-ui && npm run build:web  (VITE_API_BASE vuoto = same-origin)

# URL pubblico per link mobile / email approvazione tester
SUPERNOVA_PUBLIC_HOST=91.99.15.48
SUPERNOVA_MOBILE_PUBLIC_URL=http://91.99.15.48:8765/mobile

# ── Email approvazione tester mobile (quando clicchi Approva in Monitor tester) ──
# SUPERNOVA_MOBILE_PUBLIC_URL=http://192.168.1.203:5174
# SUPERNOVA_SMTP_HOST=smtp.gmail.com
