# SuperNova Short — hosting v3 (server sempre online, HTTPS)
# Carica prima di avviare:  Get-Content config/profiles/mobile_v3_host.env | ForEach-Object { ... }
# oppure copia le variabili in systemd / .env sul VPS

SUPERNOVA_BIND_ALL=1
SUPERNOVA_SERVE_MOBILE=1
SUPERNOVA_API_TOKEN=CAMBIA_QUESTA_CHIAVE
# Codici invito tester mobile (opzionale, separati da virgola). Se impostati, richiesti alla registrazione.
# SUPERNOVA_TESTER_INVITE_CODES=SN-PLAY-2026,SN-BETA-02
SUPERNOVA_PORT=8765
# URL PWA per email di approvazione tester (link installazione)
# SUPERNOVA_MOBILE_PUBLIC_URL=https://tuodominio.it/mobile
# NON usare CORS permissivo in produzione
# SUPERNOVA_CORS_PERMISSIVE=0
# Se PWA su altro dominio (raro):
# SUPERNOVA_CORS_ORIGINS=https://app.tuodominio.it
