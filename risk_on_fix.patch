+"""Cluster cal_factor solver must not amplify directionless / overshooting cohorts."""
+from __future__ import annotations
+
+from prediction.cluster_cal_factor import (
+    CLUSTER_CF_CEILING,
+    _pairs_mae,
+    _solve_cluster_cal_factor,
+)
+
+
+def test_holds_when_direction_unreliable():
+    # predictions anti-correlated with actuals (dir < 0.5) -> never scale
+    pairs = [(2.0, -3.0), (-2.0, 3.0), (1.5, -2.0), (-1.5, 2.0)]
+    dir_acc = sum(1 for p, a in pairs if (p > 0) == (a > 0)) / len(pairs)
+    factor, status = _solve_cluster_cal_factor(pairs, _pairs_mae(pairs, 1.0), dir_acc)
+    assert factor == 1.0
+    assert status == "direction_unreliable"
+
+
+def test_shrinks_overshooting_cohort_instead_of_compounding_up():
+    # model overshoots magnitude with correct direction -> optimal m < 1 (shrink)
+    pairs = [(10.0, 5.0), (8.0, 4.0), (-10.0, -5.0), (-6.0, -3.0)]
+    dir_acc = sum(1 for p, a in pairs if (p > 0) == (a > 0)) / len(pairs)
+    factor, status = _solve_cluster_cal_factor(pairs, _pairs_mae(pairs, 1.0), dir_acc)
+    assert status == "active"
+    assert factor < 1.0
+    assert _pairs_mae(pairs, factor) < _pairs_mae(pairs, 1.0)
+
+
+def test_no_correction_when_already_calibrated():
+    pairs = [(3.0, 3.0), (-2.0, -2.0), (4.0, 4.0), (-1.0, -1.0)]
+    dir_acc = 1.0
+    factor, status = _solve_cluster_cal_factor(pairs, _pairs_mae(pairs, 1.0), dir_acc)
+    assert factor == 1.0
+    assert status == "no_improvement"
+
+
+def test_modest_undershoot_is_not_pinned_to_the_ceiling():
+    # OLS magnitude ratio ~1.4 would clip to the 1.3 ceiling; the ridge prior
+    # shrinks it toward 1.0 so the cohort settles off the rail.
+    pairs = [(5.0, 7.0), (4.0, 5.6), (3.0, 4.2), (6.0, 8.4), (2.0, 2.8), (4.5, 6.3)]
+    dir_acc = 1.0
+    factor, status = _solve_cluster_cal_factor(pairs, _pairs_mae(pairs, 1.0), dir_acc)
+    assert status == "active"
+    assert 1.0 < factor < CLUSTER_CF_CEILING
+
+
+def test_tail_actual_is_trimmed_from_the_regression():
+    # A calibrated core (pred==actual) plus one unpredictable 80pp readout. The
+    # tail would otherwise drag the factor toward the ceiling; it is dropped
+    # (|actual| > cap) so the core wins and no spurious correction is made.
+    pairs = [(3.0, 3.0)] * 8 + [(1.0, 80.0)]
+    dir_acc = sum(1 for p, a in pairs if (p > 0) == (a > 0)) / len(pairs)
+    factor, status = _solve_cluster_cal_factor(pairs, _pairs_mae(pairs, 1.0), dir_acc)
+    assert factor == 1.0
+    assert status == "no_improvement"
diff --git a/tests/test_effectiveness_delta.py b/tests/test_effectiveness_delta.py
new file mode 100644
index 0000000..f25c23c
--- /dev/null
+++ b/tests/test_effectiveness_delta.py
@@ -0,0 +1,115 @@
+"""Effectiveness verdicts must isolate each layer's effect on the SAME outcome pool.
+
+Regression for the temporal-misalignment bug where ``mae_after`` came from the
+live snapshot while ``mae_before`` came from the previous week, conflating a
+layer's effect with week-over-week drift of the pool.
+"""
+from __future__ import annotations
+
+import json
+
+from prediction import learning_lab as ll
+
+LIVE = {
+    "n_outcomes": 1000,
+    "n_regime_outcomes": 1000,
+    "mae_baseline": 8.0,
+    "mae_before_cluster": 8.0,
+    "mae_after_cluster": 7.5,
+    "dir_before_cluster": 0.50,
+    "dir_after_cluster": 0.55,
+    "mae_before_regime": 7.5,
+    "mae_after_regime": 7.0,
+    "dir_before_regime": 0.50,
+    "dir_after_regime": 0.52,
+    "mae_global_before": 7.0,
+    "mae_with_all": 6.9,
+    "dir_global_before": 0.50,
+    "dir_with_all": 0.50,
+}
+
+
+def _rows(monkeypatch, tmp_path, *, eis_overview=None, polygon_doc=None):
+    hist = tmp_path / "learning_history.json"
+    hist.write_text(json.dumps({"weeks": []}), encoding="utf-8")
+    monkeypatch.setattr(ll, "LEARNING_HISTORY_JSON", str(hist))
+    rows = ll.build_effectiveness_delta(
+        live_metrics=LIVE,
+        eis_overview=eis_overview or {"learning_history": [], "effectiveness": {}, "n_events_scored": 0},
+        polygon_doc=polygon_doc or {"learning_history": [], "n_samples": 0},
+    )
+    return {r["mechanism"]: r for r in rows}
+
+
+def test_layer_delta_is_within_snapshot_not_cross_week(monkeypatch, tmp_path):
+    rows = _rows(monkeypatch, tmp_path)
+    # each delta = after - before of the SAME live snapshot
+    assert rows["cluster_cf"]["mae_delta_pp"] == -0.5
+    assert rows["regime_mult"]["mae_delta_pp"] == -0.5
+    assert rows["global_cf"]["mae_delta_pp"] == -0.1
+
+
+def test_history_absent_does_not_fabricate_before(monkeypatch, tmp_path):
+    # with no history, before must still come from the live snapshot (not None)
+    rows = _rows(monkeypatch, tmp_path)
+    assert rows["regime_mult"]["mae_delta_pp"] is not None
+    assert rows["regime_mult"]["dir_delta_pp"] == 2.0
+
+
+def test_eis_row_judged_on_magnitude_mae_not_correlation(monkeypatch, tmp_path):
+    # Super score = raw * positive scalar, so corr_super == corr_raw (lift 0 by
+    # construction). The row must instead reflect the magnitude MAE the cal_factor
+    # actually moves: raw vs super within the same snapshot.
+    eis = {
+        "learning_history": [
+            {
+                "date": "2026-06-24",
+                "mean_corr_raw_7d": 0.65,
+                "mean_corr_super_7d": 0.65,  # identical -> corr-based delta is 0
+                "mean_mae_raw_7d": 8.0,
+                "mean_mae_super_7d": 7.0,
+            }
+        ],
+        "effectiveness": {},
+        "n_events_scored": 500,
+    }
+    rows = _rows(monkeypatch, tmp_path, eis_overview=eis)
+    r = rows["eis_super"]
+    assert r["mae_before"] == 8.0 and r["mae_after"] == 7.0
+    assert r["mae_delta_pp"] == -1.0
+    # corr is flat (0.0) but the MAE-based verdict now shows the layer is working
+    assert r["dir_delta_pp"] == 0.0
+    assert r["verdict"] == "learning"
+
+
+def test_polygon_baseline_is_week_over_week_not_yesterday(monkeypatch, tmp_path):
+    # Daily snapshots: yesterday barely moves (pins verdict at 0.0). The baseline
+    # must step back >=7 days so real drift is visible.
+    poly = {
+        "learning_history": [
+            {"date": "2026-06-10", "mean_corr_match_stock": 0.10},
+            {"date": "2026-06-17", "mean_corr_match_stock": 0.15},
+            {"date": "2026-06-23", "mean_corr_match_stock": 0.175},
+            {"date": "2026-06-24", "mean_corr_match_stock": 0.175},
+        ],
+        "n_samples": 500,
+    }
+    rows = _rows(monkeypatch, tmp_path, polygon_doc=poly)
+    r = rows["polygon_match"]
+    # baseline is 06-17 (>=7d before 06-24), NOT 06-23 (yesterday)
+    assert r["dir_before"] == 0.15
+    assert r["dir_delta_pp"] == 2.5
+
+
+def test_polygon_baseline_collecting_without_week_of_history(monkeypatch, tmp_path):
+    # Only same-week daily points -> no >=7d baseline -> honest "collecting".
+    poly = {
+        "learning_history": [
+            {"date": "2026-06-23", "mean_corr_match_stock": 0.175},
+            {"date": "2026-06-24", "mean_corr_match_stock": 0.175},
+        ],
+        "n_samples": 500,
+    }
+    rows = _rows(monkeypatch, tmp_path, polygon_doc=poly)
+    assert rows["polygon_match"]["dir_before"] is None
+    assert rows["polygon_match"]["dir_delta_pp"] is None
diff --git a/tests/test_eis_super_mae.py b/tests/test_eis_super_mae.py
new file mode 100644
index 0000000..4d738fb
--- /dev/null
+++ b/tests/test_eis_super_mae.py
@@ -0,0 +1,63 @@
+"""EIS super-score effectiveness must use a magnitude-sensitive metric.
+
+The super score is ``raw * K`` with ``K`` a positive per-bin scalar, so Pearson
+ρ(super, ΔP) ≡ ρ(raw, ΔP) (correlation is scale-invariant). The old ``lift``
+(corr_super − corr_raw) was therefore structurally 0.0 forever. The MAE of
+|score| vs |ΔP| does move with the cal_factor and is the correct yardstick.
+"""
+from __future__ import annotations
+
+from prediction import eis_super_score_learning as e
+
+
+def _rows(dbc: int, n: int = 12, *, scale: float = 3.0) -> list[dict]:
+    factor = e.cd_distance_factor(dbc)
+    rows = []
+    for i in range(n):
+        eis = (i - n / 2) * 3.0
+        if abs(eis) < 1.0:
+            eis = 5.0
+        raw = eis * factor
+        rows.append(
+            {
+                "eis_score": eis,
+                "days_before_cd": dbc,
+                "delta_p_7d": scale * raw,  # |ΔP| = scale * |raw|
+                "delta_p_1d": raw,
+            }
+        )
+    return rows
+
+
+def test_correlation_is_blind_to_scaling_but_mae_is_not():
+    dbc = 150
+    label = e.resolve_cd_bin(dbc)[2]
+    blend = 0.6
+    # super = raw * (blend*cal + (1-blend)); pick cal so K == scale (3.0) -> super ≈ |ΔP|
+    cal = (3.0 - (1.0 - blend)) / blend
+    state = {"windows": {label: {"cal_factor": cal}}, "global_score_blend": blend}
+
+    timeline = e.build_correlation_timeline(_rows(dbc, scale=3.0), state=state)
+    row = next(r for r in timeline if r["window"] == label)
+
+    # Pearson lift is structurally zero (the bug): scaling can't change correlation.
+    assert row["lift_7d"] == 0.0
+    # The magnitude MAE captures the calibration improvement (the fix).
+    assert row["mae_raw_7d"] is not None and row["mae_super_7d"] is not None
+    assert row["mae_super_7d"] < row["mae_raw_7d"]
+    assert row["mae_lift_7d"] is not None and row["mae_lift_7d"] > 0
+
+
+def test_history_dedup_replaces_same_day_snapshot(monkeypatch, tmp_path):
+    # Re-running the cycle the same day must replace, not append, to avoid
+    # identical adjacent points collapsing the week-over-week delta to 0.0.
+    state_path = tmp_path / "eis_super_score_learning.json"
+    monkeypatch.setattr(e, "_EIS_SUPER_SCORE_JSON", state_path)
+    monkeypatch.setattr(e, "_load_clinical_records", lambda: [])
+
+    e.run_eis_super_score_learning_cycle(dry_run=False)
+    e.run_eis_super_score_learning_cycle(dry_run=False)
+
+    doc = e.load_eis_super_score_state()
+    dates = [h.get("date") for h in doc.get("history") or []]
+    assert dates.count(e._today_iso()) == 1
diff --git a/tests/test_feedback_outlier_guard.py b/tests/test_feedback_outlier_guard.py
new file mode 100644
index 0000000..9fda0b0
--- /dev/null
+++ b/tests/test_feedback_outlier_guard.py
@@ -0,0 +1,41 @@
+"""Validation feedback loop must not let a corrupt MAE outlier distort the pool.
+
+A single absurd value (e.g. MAE 1668%) otherwise dominates ``portfolio_avg_mae``
+and skews every relative under/over-performer threshold, and would also drive a
+cal_factor change off garbage data.
+"""
+from __future__ import annotations
+
+from prediction import validation_feedback_loop as v
+
+
+def _perf() -> dict[str, dict]:
+    return {
+        "GOOD": {"persistent_mae": 4.0, "direction_acc": 0.8, "bias": 0.5, "n_nodes": 6, "flag": "ok"},
+        "OKAY": {"persistent_mae": 12.0, "direction_acc": 0.55, "bias": 1.0, "n_nodes": 6, "flag": "ok"},
+        "KALA": {"persistent_mae": 1668.6, "direction_acc": 0.5, "bias": 10.0, "n_nodes": 6, "flag": "ok"},
+    }
+
+
+def test_portfolio_center_excludes_outlier():
+    center = v._portfolio_center_mae(_perf())
+    # mean of the two sane tickers (4, 12) == 8.0, NOT dragged up by 1668.
+    assert center == 8.0
+
+
+def test_outlier_is_flagged_and_never_drives_a_cal_change():
+    perf = _perf()
+    changes, flags = v._propose_cal_changes(perf, {"events": {}})
+
+    assert perf["KALA"]["flag"] == "data_outlier"
+    assert "KALA" in flags["data_outliers"]
+    assert perf["KALA"]["cal_factor"] == 1.0  # unchanged
+    assert all(ch["ticker"] != "KALA" for ch in changes)
+
+
+def test_summary_reports_robust_avg_and_outliers():
+    perf = _perf()
+    changes, flags = v._propose_cal_changes(perf, {"events": {}})
+    summary = v.build_portfolio_summary(perf, changes, flags)
+    assert summary["portfolio_avg_mae"] == 8.0
+    assert summary["data_outliers"] == ["KALA"]
diff --git a/tests/test_regime_calibration_fix.py b/tests/test_regime_calibration_fix.py
new file mode 100644
index 0000000..680d2ad
--- /dev/null
+++ b/tests/test_regime_calibration_fix.py
@@ -0,0 +1,111 @@
+"""Tests for the RISK_ON regime-multiplier fix.
+
+Covers the three root causes:
+  * the date funnel (current regime stamped onto historical outcomes),
+  * the dimensionally-incoherent ``1 - bias/12`` formula, and
+  * the absence of a self-validation guard.
+"""
+from __future__ import annotations
+
+from prediction import regime_calibration as rc
+
+
+def test_get_regime_at_date_does_not_funnel(monkeypatch):
+    """Past dates must not inherit the *current* regime."""
+    monkeypatch.setattr(rc, "load_regime_history", lambda: {})
+    monkeypatch.setattr(rc, "get_current_regime", lambda: "RISK_ON")
+
+    # Unknown past date -> UNKNOWN (excluded), never the live regime.
+    assert rc.get_regime_at_date("2026-01-01") == rc.UNKNOWN_REGIME
+    # A recorded historical regime is honoured.
+    monkeypatch.setattr(rc, "load_regime_history", lambda: {"2026-01-02": "RISK_OFF"})
+    assert rc.get_regime_at_date("2026-01-02") == "RISK_OFF"
+    # Today resolves to the live regime.
+    assert rc.get_regime_at_date(rc._today_iso()) == "RISK_ON"
+
+
+def test_enrich_tags_unknown_not_current(monkeypatch):
+    monkeypatch.setattr(rc, "load_regime_history", lambda: {})
+    monkeypatch.setattr(rc, "get_current_regime", lambda: "RISK_ON")
+    tagged = rc.enrich_outcomes_with_regime([{"ticker": "AAA", "date": "2026-01-01", "pred": 3, "actual": 8}])
+    assert tagged[0]["regime"] == rc.UNKNOWN_REGIME
+
+
+def test_solver_holds_when_direction_unreliable():
+    # Wrong sign on most pairs -> direction accuracy < 0.5 -> no magnitude scaling.
+    pairs = [(3.0, -8.0)] * 7 + [(3.0, 8.0)] * 3
+    mae = sum(abs(p - a) for p, a in pairs) / len(pairs)
+    dir_acc = sum(1 for p, a in pairs if (p > 0) == (a > 0)) / len(pairs)
+    m, status = rc._solve_regime_multiplier(pairs, mae, dir_acc)
+    assert status == "direction_unreliable"
+    assert m == 1.0
+
+
+def test_solver_scales_and_reduces_error_on_healthy_sample():
+    # Correct sign, systematic under-magnitude (pred half of actual).
+    pairs = [(4.0, 8.0), (5.0, 10.0), (3.0, 6.0), (6.0, 12.0), (2.0, 4.0),
+             (4.5, 9.0), (3.5, 7.0), (5.5, 11.0)]
+    mae = sum(abs(p - a) for p, a in pairs) / len(pairs)
+    dir_acc = sum(1 for p, a in pairs if (p > 0) == (a > 0)) / len(pairs)
+    m, status = rc._solve_regime_multiplier(pairs, mae, dir_acc)
+    assert status == "active"
+    assert m > 1.0  # scales magnitude up toward the actuals
+    assert rc._pairs_mae(pairs, m) < mae  # genuinely reduces error
+
+
+def test_solver_no_improvement_when_already_calibrated():
+    pairs = [(5.0, 5.0)] * 8
+    m, status = rc._solve_regime_multiplier(pairs, 0.0, 1.0)
+    assert status == "no_improvement"
+    assert m == 1.0
+
+
+def test_solver_shrinks_off_the_rail_instead_of_pinning():
+    # OLS magnitude ratio ~1.4 would clip to the ceiling; the ridge prior shrinks
+    # it toward 1.0 so the multiplier settles off the rail.
+    pairs = [(5.0, 7.0), (4.0, 5.6), (3.0, 4.2), (6.0, 8.4), (2.0, 2.8), (4.5, 6.3)]
+    mae = rc._pairs_mae(pairs, 1.0)
+    m, status = rc._solve_regime_multiplier(pairs, mae, 1.0)
+    assert status == "active"
+    assert 1.0 < m < rc.REGIME_MULT_CEILING
+
+
+def test_solver_trims_tail_actual_from_regression():
+    pairs = [(3.0, 3.0)] * 8 + [(1.0, 80.0)]
+    mae = rc._pairs_mae(pairs, 1.0)
+    dir_acc = sum(1 for p, a in pairs if (p > 0) == (a > 0)) / len(pairs)
+    m, status = rc._solve_regime_multiplier(pairs, mae, dir_acc)
+    assert m == 1.0
+    assert status == "no_improvement"
+
+
+def test_compute_neutralizes_broken_risk_on_sample(monkeypatch, tmp_path):
+    monkeypatch.setattr(rc, "REGIME_MULTIPLIERS_JSON", str(tmp_path / "rm.json"))
+    monkeypatch.setattr(rc, "LEARNING_HISTORY_JSON", str(tmp_path / "lh.json"))
+    monkeypatch.setattr(rc, "get_current_regime", lambda: "RISK_ON")
+    # 33 RISK_ON outcomes, mostly wrong-signed (direction ~0.39).
+    outcomes = [{"pred": 3.0, "actual": -8.0, "regime": "RISK_ON"} for _ in range(20)]
+    outcomes += [{"pred": 3.0, "actual": 8.0, "regime": "RISK_ON"} for _ in range(13)]
+    doc = rc.compute_regime_multipliers(outcomes, dry_run=True)
+    risk_on = doc["regimes"]["RISK_ON"]
+    assert risk_on["multiplier"] == 1.0
+    assert risk_on["status"] == "direction_unreliable"
+
+
+def test_compute_circuit_breaker_freezes_divergence(monkeypatch, tmp_path):
+    import json
+
+    # History: RISK_ON multiplier drifting up while regime layer worsens.
+    weeks = {
+        "weeks": [
+            {"regime_multipliers": {"RISK_ON": 1.0}, "mae_after_regime": 7.1, "mae_baseline": 7.2},
+            {"regime_multipliers": {"RISK_ON": 1.1}, "mae_after_regime": 7.6, "mae_baseline": 7.2},
+            {"regime_multipliers": {"RISK_ON": 1.2}, "mae_after_regime": 7.9, "mae_baseline": 7.2},
+        ]
+    }
+    lh = tmp_path / "lh.json"
+    lh.write_text(json.dumps(weeks), encoding="utf-8")
+    monkeypatch.setattr(rc, "LEARNING_HISTORY_JSON", str(lh))
+    cb = rc._circuit_breaker_for_regime("RISK_ON", 1.3)
+    assert cb.triggered is True
+    assert cb.value == 1.0
