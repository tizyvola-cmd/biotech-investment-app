+"""Effectiveness verdicts must isolate each layer's effect on the SAME outcome pool.
+
+Regression for the temporal-misalignment bug where ``mae_after`` came from the
+live snapshot while ``mae_before`` came from the previous week, conflating a
+layer's effect with week-over-week drift of the pool.
+"""
+from __future__ import annotations
+
+import json
+
+from prediction import learning_lab as ll
+
+LIVE = {
+    "n_outcomes": 1000,
+    "n_regime_outcomes": 1000,
+    "mae_baseline": 8.0,
+    "mae_before_cluster": 8.0,
+    "mae_after_cluster": 7.5,
+    "dir_before_cluster": 0.50,
+    "dir_after_cluster": 0.55,
+    "mae_before_regime": 7.5,
+    "mae_after_regime": 7.0,
+    "dir_before_regime": 0.50,
+    "dir_after_regime": 0.52,
+    "mae_global_before": 7.0,
+    "mae_with_all": 6.9,
+    "dir_global_before": 0.50,
+    "dir_with_all": 0.50,
+}
+
+
+def _rows(monkeypatch, tmp_path):
+    hist = tmp_path / "learning_history.json"
+    hist.write_text(json.dumps({"weeks": []}), encoding="utf-8")
+    monkeypatch.setattr(ll, "LEARNING_HISTORY_JSON", str(hist))
+    rows = ll.build_effectiveness_delta(
+        live_metrics=LIVE,
+        eis_overview={"learning_history": [], "effectiveness": {}, "n_events_scored": 0},
+        polygon_doc={"learning_history": [], "n_samples": 0},
+    )
+    return {r["mechanism"]: r for r in rows}
+
+
+def test_layer_delta_is_within_snapshot_not_cross_week(monkeypatch, tmp_path):
+    rows = _rows(monkeypatch, tmp_path)
+    # each delta = after - before of the SAME live snapshot
+    assert rows["cluster_cf"]["mae_delta_pp"] == -0.5
+    assert rows["regime_mult"]["mae_delta_pp"] == -0.5
+    assert rows["global_cf"]["mae_delta_pp"] == -0.1
+
+
+def test_history_absent_does_not_fabricate_before(monkeypatch, tmp_path):
+    # with no history, before must still come from the live snapshot (not None)
+    rows = _rows(monkeypatch, tmp_path)
+    assert rows["regime_mult"]["mae_delta_pp"] is not None
+    assert rows["regime_mult"]["dir_delta_pp"] == 2.0
