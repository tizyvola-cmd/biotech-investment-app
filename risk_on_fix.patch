+def _solve_regime_multiplier(
+    pairs: list[tuple[float, float]],
+    mae_baseline: float,
+    dir_acc: float,
+) -> tuple[float, str]:
+    """Magnitude-scaling factor that minimises in-sample error, with guards.
+
+    Replaces the dimensionally-incoherent ``1 - bias/12`` (an additive bias fed
+    into a multiplicative factor). The optimal scalar ``m`` minimising
+    ``sum((m*pred - actual)^2)`` is ``sum(pred*actual)/sum(pred^2)``. Two guards
+    keep it from amplifying a broken sample:
+      * if direction accuracy < threshold the sample is directionally unreliable
+        (scaling would amplify wrong-signed predictions) -> hold at 1.0;
+      * the clipped solution is only applied if it actually reduces in-sample MAE
+        vs no correction; otherwise hold at 1.0.
+    """
+    if dir_acc < REGIME_MIN_DIRECTION_ACC:
+        return 1.0, "direction_unreliable"
+    den = sum(p * p for p, _ in pairs)
+    if den <= 1e-9:
+        return 1.0, "no_improvement"
+    m = sum(p * a for p, a in pairs) / den
+    m = max(REGIME_MULT_FLOOR, min(REGIME_MULT_CEILING, m))
+    if _pairs_mae(pairs, m) >= mae_baseline - 1e-9:
+        return 1.0, "no_improvement"
+    return m, "active"
+
