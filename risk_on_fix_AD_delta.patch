diff --git a/tests/test_eis_super_mae.py b/tests/test_eis_super_mae.py
new file mode 100644
index 0000000..4d738fb
--- /dev/null
+++ b/tests/test_eis_super_mae.py
@@ -0,0 +1,63 @@
+"""EIS super-score effectiveness must use a magnitude-sensitive metric.
+
+The super score is ``raw * K`` with ``K`` a positive per-bin scalar, so Pearson
+ρ(super, ΔP) ≡ ρ(raw, ΔP) (correlation is scale-invariant). The old ``lift``
+(corr_super − corr_raw) was therefore structurally 0.0 forever. The MAE of
+|score| vs |ΔP| does move with the cal_factor and is the correct yardstick.
+"""
+from __future__ import annotations
+
+from prediction import eis_super_score_learning as e
+
+
+def _rows(dbc: int, n: int = 12, *, scale: float = 3.0) -> list[dict]:
+    factor = e.cd_distance_factor(dbc)
+    rows = []
+    for i in range(n):
+        eis = (i - n / 2) * 3.0
+        if abs(eis) < 1.0:
+            eis = 5.0
+        raw = eis * factor
+        rows.append(
+            {
+                "eis_score": eis,
+                "days_before_cd": dbc,
+                "delta_p_7d": scale * raw,  # |ΔP| = scale * |raw|
+                "delta_p_1d": raw,
+            }
+        )
+    return rows
+
+
+def test_correlation_is_blind_to_scaling_but_mae_is_not():
+    dbc = 150
+    label = e.resolve_cd_bin(dbc)[2]
+    blend = 0.6
+    # super = raw * (blend*cal + (1-blend)); pick cal so K == scale (3.0) -> super ≈ |ΔP|
+    cal = (3.0 - (1.0 - blend)) / blend
+    state = {"windows": {label: {"cal_factor": cal}}, "global_score_blend": blend}
+
+    timeline = e.build_correlation_timeline(_rows(dbc, scale=3.0), state=state)
+    row = next(r for r in timeline if r["window"] == label)
+
+    # Pearson lift is structurally zero (the bug): scaling can't change correlation.
+    assert row["lift_7d"] == 0.0
+    # The magnitude MAE captures the calibration improvement (the fix).
+    assert row["mae_raw_7d"] is not None and row["mae_super_7d"] is not None
+    assert row["mae_super_7d"] < row["mae_raw_7d"]
+    assert row["mae_lift_7d"] is not None and row["mae_lift_7d"] > 0
+
+
+def test_history_dedup_replaces_same_day_snapshot(monkeypatch, tmp_path):
+    # Re-running the cycle the same day must replace, not append, to avoid
+    # identical adjacent points collapsing the week-over-week delta to 0.0.
+    state_path = tmp_path / "eis_super_score_learning.json"
+    monkeypatch.setattr(e, "_EIS_SUPER_SCORE_JSON", state_path)
+    monkeypatch.setattr(e, "_load_clinical_records", lambda: [])
+
+    e.run_eis_super_score_learning_cycle(dry_run=False)
+    e.run_eis_super_score_learning_cycle(dry_run=False)
+
+    doc = e.load_eis_super_score_state()
+    dates = [h.get("date") for h in doc.get("history") or []]
+    assert dates.count(e._today_iso()) == 1
