+
+A single absurd value (e.g. MAE 1668%) otherwise dominates ``portfolio_avg_mae``
+and skews every relative under/over-performer threshold, and would also drive a
+cal_factor change off garbage data.
+"""
+from __future__ import annotations
+
+from prediction import validation_feedback_loop as v
+
+
+def _perf() -> dict[str, dict]:
+    return {
+        "GOOD": {"persistent_mae": 4.0, "direction_acc": 0.8, "bias": 0.5, "n_nodes": 6, "flag": "ok"},
+        "OKAY": {"persistent_mae": 12.0, "direction_acc": 0.55, "bias": 1.0, "n_nodes": 6, "flag": "ok"},
+        "KALA": {"persistent_mae": 1668.6, "direction_acc": 0.5, "bias": 10.0, "n_nodes": 6, "flag": "ok"},
+    }
+
+
+def test_portfolio_center_excludes_outlier():
+    center = v._portfolio_center_mae(_perf())
+    # mean of the two sane tickers (4, 12) == 8.0, NOT dragged up by 1668.
+    assert center == 8.0
+
+
+def test_outlier_is_flagged_and_never_drives_a_cal_change():
+    perf = _perf()
+    changes, flags = v._propose_cal_changes(perf, {"events": {}})
+
+    assert perf["KALA"]["flag"] == "data_outlier"
+    assert "KALA" in flags["data_outliers"]
+    assert perf["KALA"]["cal_factor"] == 1.0  # unchanged
+    assert all(ch["ticker"] != "KALA" for ch in changes)
+
+
+def test_summary_reports_robust_avg_and_outliers():
+    perf = _perf()
+    changes, flags = v._propose_cal_changes(perf, {"events": {}})
+    summary = v.build_portfolio_summary(perf, changes, flags)
+    assert summary["portfolio_avg_mae"] == 8.0
+    assert summary["data_outliers"] == ["KALA"]
